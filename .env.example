# ==============================================================================
# Environment Variables
# Copy this file to .env.local and fill in your values
# ==============================================================================

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# IMPORTANT SECURITY NOTES:
# ==============================================================================
#
# 1. NEVER commit .env.local to version control
# 2. The ANON key is safe to expose in the browser (it's rate-limited and RLS-protected)
# 3. NEVER expose your SERVICE_ROLE_KEY to the client
# 4. For server-side operations, use environment variables that are NOT prefixed with VITE_
#
# ==============================================================================
